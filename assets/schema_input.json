{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/PROJECT-DEFIANT/gentroflow/dev/assets/schema_input.json",
    "title": "PROJECT-DEFIANT/gentroflow pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "dateAddedToCatalog": {
                "type": "string",
                "format": "date",
                "meta": [
                    "date_added"
                ]
            },
            "pubmedId": {
                "type": [
                    "string",
                    "integer"
                ],
                "format": "^\\d+",
                "meta": [
                    "pubmed_id"
                ]
            },
            "firstAuthor": {
                "type": "string",
                "format": "^\\S+ \\S{1}%",
                "meta": [
                    "first_author"
                ]
            },
            "publicationDate": {
                "type": "string",
                "format": "date",
                "meta": [
                    "publication_date"
                ]
            },
            "publicationJournal": {
                "type": "string",
                "meta": [
                    "publication_journal"
                ]
            },
            "publicationName": {
                "type": "string",
                "meta": [
                    "publication_name"
                ]
            },
            "phenotype": {
                "type": "string",
                "meta": [
                    "phenotype"
                ]
            },
            "initialSampleSize": {
                "type": "string",
                "meta": [
                    "initial_sample_size"
                ]
            },
            "replicationSampleSize": {
                "type": "string",
                "meta": [
                    "replication_sample_size"
                ]
            },
            "platform": {
                "type": "string",
                "pattern": "^(Illumina|Affymetrix).*$",
                "errorMessage": "GWAS Catalog platform must be either 'Illumina' or 'Affymetrix'",
                "meta": [
                    "platform"
                ]
            },
            "mappedTrait": {
                "type": "string",
                "meta": [
                    "mapped_trait"
                ]
            },
            "mappedTraitURI": {
                "type": "string",
                "pattern": "^http.*$",
                "meta": [
                    "mapped_trait_uri"
                ]
            },
            "studyAccession": {
                "type": "string",
                "pattern": "^GCST\\d+",
                "errorMessage": "GWAS Catalog studyId must follow the pattern 'GCST\\d+'",
                "meta": [
                    "id"
                ]
            },
            "genotypingTechnology": {
                "type": "string",
                "pattern": "^(Genome-wide genotyping array|Targeted genotyping array|Sequencing).*$",
                "meta": [
                    "genotyping_technology"
                ]
            },
            "submissionDate": {
                "type": "string",
                "format": "date",
                "meta": [
                    "submission_date"
                ]
            },
            "statisticalModel": {
                "type": "string",
                "meta": [
                    "statistical_model"
                ]
            },
            "backgroundTrait": {
                "type": "string",
                "meta": [
                    "background_trait"
                ]
            },
            "mappedBackgroundTrait": {
                "type": "string",
                "meta": [
                    "mapped_background_trait"
                ]
            },
            "mappedBackgroundTraitURI": {
                "type": "string",
                "meta": [
                    "mapped_background_trait_uri"
                ]
            },
            "cohort": {
                "type": "string",
                "meta": [
                    "cohort"
                ]
            },
            "fullSummaryStatistics": {
                "type": "boolean",
                "meta": [
                    "sumstat_available"
                ]
            },
            "summaryStatisticsLocation": {
                "type": "string",
                "format": "file-path",
                "pattern": "^\\S+$",
                "meta": [
                    "sumstat_path"
                ]
            },
            "gxe": {
                "type": "boolean",
                "meta": [
                    "gxe"
                ]
            }
        },
        "required": [
            "studyAccession"
        ]
    }
}